# AgentMesh Environment - Phase 0

NODE_ENV=development

# Gateway
GATEWAY_PORT=3001
GATEWAY_HOST=0.0.0.0
GATEWAY_LOG_LEVEL=info

# Control Plane
CONTROL_PLANE_PORT=3002
CONTROL_PLANE_HOST=0.0.0.0
CONTROL_PLANE_LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://agentmesh:agentmesh_secret@localhost:5432/agentmesh
POSTGRES_USER=agentmesh
POSTGRES_PASSWORD=agentmesh_secret
POSTGRES_DB=agentmesh
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# NATS
NATS_URL=nats://localhost:4222
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=agentmesh-artifacts
S3_FORCE_PATH_STYLE=true
MINIO_CONSOLE_PORT=9001

# Auth
JWT_SECRET=dev_jwt_secret_change_in_production
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Telemetry
OTEL_SERVICE_NAME=agentmesh
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on
